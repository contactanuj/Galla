# Galla — environment variables
# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored. These EXPO_PUBLIC_* vars are bundled into the client,
# so only use the PUBLIC anon key here — never the service_role key.
#
# Leave both blank to run in local-only mode (SQLite only, no cloud sync).

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
